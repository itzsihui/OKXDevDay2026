        <mxCell id="footer" value="Repo: github.com/itzsihui/Aisle · Deploy: npm run protocol:deploy (infra/protocol.yaml) · Demo: /demo" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#9CA3AF;" vertex="1" parent="1">
