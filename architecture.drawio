          <mxGeometry x="800" y="580" width="760" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="src/lib/agents/card.ts — runCardAgent&#xa;src/lib/straitsx/mcp.ts — issueScopedCard&#xa;src/lib/straitsx/mcp-client.ts — SSE client&#xa;src/lib/straitsx/eip3009.ts — auth helpers&#xa;handlers.ts — handleCheckout&#xa;/api/card-mandate route" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="code">
          <mxGeometry x="30" y="50" width="700" height="130" as="geometry" />
