        </mxCell>
        <mxCell id="mand-assert" value="assertMandateAllows()&#xa;&#xa;• spendCap ≥ order amount&#xa;• merchant matches store&#xa;• not expired&#xa;• status not already burned" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="mandate">
          <mxGeometry x="380" y="50" width="300" height="130" as="geometry" />
