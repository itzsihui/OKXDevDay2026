<diagram id="aisle-protocol" name="Protocol Surface &amp; Discovery">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Aisle Protocol Surface — Discovery &amp; Handlers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Same handlers in Next.js (/s/:slug/…) and AWS Lambda (PROTOCOL_BASE_URL). Agents never scrape HTML." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Network discovery -->
        <mxCell id="net" value="Network Discovery (origin-level)" style="swimlane;horizontal=0;startSize=28;fillColor=#EFF6FF;strokeColor=#2563EB;fontStyle=1;fontSize=13;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="llms-root" value="GET /llms.txt&#xa;Network index for agents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="net">
          <mxGeometry x="40" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="registry" value="GET /registry.json&#xa;Store + SKU index&#xa;(buyer product match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="net">
          <mxGeometry x="280" y="50" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resolve" value="resolveBuyerTarget()&#xa;slug OR registry match&#xa;by product name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="net">
          <mxGeometry x="520" y="50" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Per-store surface -->
        <mxCell id="store" value="Per-Store Protocol — /s/:slug/…" style="swimlane;horizontal=0;startSize=28;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontSize=13;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1520" height="280" as="geometry" />
        </mxCell>

        <mxCell id="disc" value="Discover" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;fontColor=#92400E;" vertex="1" parent="store">
          <mxGeometry x="40" y="40" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s-llms" value="GET llms.txt&#xa;Human-readable agent brief&#xa;rails + endpoint list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="store">
          <mxGeometry x="40" y="70" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s-agent" value="GET agent.json&#xa;ACP agent card&#xa;protocols + buy URLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="store">
          <mxGeometry x="270" y="70" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s-cat" value="GET catalog.json&#xa;SKUs · prices (XSGD)&#xa;rails: x402 + card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="store">
          <mxGeometry x="500" y="70" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="pay" value="Pay" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=12;fontColor=#166534;" vertex="1" parent="store">
          <mxGeometry x="760" y="40" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s-buy" value="POST /buy&#xa;Rail A — x402&#xa;no sig → 402&#xa;valid tx → 200 + order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="store">
          <mxGeometry x="760" y="70" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s-checkout" value="POST /checkout&#xa;Rail B — StraitsX&#xa;mandate assert&#xa;→ paid + burn card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="store">
          <mxGeometry x="1010" y="70" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s-orders" value="GET /orders/:id&#xa;Receipt / status&#xa;txHash · explorer · mandate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="store">
          <mxGeometry x="1260" y="70" width="220" height="100" as="geometry" />
        </mxCell>

        <mxCell id="impl" value="Implementation: src/lib/protocol/handlers.ts · routes under src/app/s/[slug]/ · services/protocol (Hono) mirrors the same surface" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#78350F;" vertex="1" parent="store">
          <mxGeometry x="40" y="210" width="1400" height="40" as="geometry" />
        </mxCell>

        <!-- Sequence strip -->
        <mxCell id="seq" value="Typical agent path" style="swimlane;horizontal=0;startSize=28;fillColor=#F8FAFC;strokeColor=#64748B;fontStyle=1;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1. Resolve&#xa;slug or&#xa;/registry.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="40" y="50" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2. GET&#xa;llms.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="260" y="50" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3. GET&#xa;catalog.json&#xa;match SKU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="460" y="50" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4. Choose rail&#xa;x402 /buy&#xa;or card /checkout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="680" y="50" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step5" value="5. Settle&#xa;chain or mandate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="920" y="50" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step6" value="6. GET&#xa;orders/:id&#xa;receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="1140" y="50" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="step7" value="7. Ops&#xa;/dashboard&#xa;/api/events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#9A3412;fontStyle=1;" vertex="1" parent="seq">
          <mxGeometry x="1360" y="50" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e-s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;endArrow=block;endFill=1;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#EA580C;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e-reg" value="product match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#1E40AF;endArrow=block;endFill=1;" edge="1" parent="1" source="registry" target="resolve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-net-store" value="pick /s/:slug" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#1E40AF;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="net" target="store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Next tabs: x402 handshake · StraitsX card rail" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#9CA3AF;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="600" height="24" as="geometry" />
        </mxCell>
      </root>
