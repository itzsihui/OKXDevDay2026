<diagram id="aisle-straitsx" name="Rail B — StraitsX Scoped Card">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Rail B — StraitsX Scoped Virtual Card (in depth)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="780" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One-time mandate: spend cap = SKU price · merchant whitelist · short TTL · burn after checkout. MCP URL from STRAITSX_MCP_URL (sandbox/sse or production)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="24" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="card-agent" value="Card Agent&#xa;runCardAgent&#xa;/api/card-mandate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="StraitsX Card MCP&#xa;issueScopedCard()&#xa;SSE sandbox / production" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proto" value="Protocol&#xa;POST /s/:slug/checkout&#xa;handleCheckout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="Repo&#xa;burnMandate&#xa;save Order (straitsx-card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="120" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Flow steps -->
        <mxCell id="flow" value="Mandate lifecycle" style="swimlane;horizontal=0;startSize=28;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontSize=13;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="1520" height="280" as="geometry" />
        </mxCell>

        <mxCell id="f1" value="1. Discover&#xa;resolveBuyerTarget&#xa;GET llms.txt&#xa;GET catalog.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="flow">
          <mxGeometry x="30" y="50" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="2. Issue mandate&#xa;spendCap = SKU&#xa;merchant whitelist&#xa;expiresAt (TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="flow">
          <mxGeometry x="250" y="50" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="3. Card opaque id&#xa;truncatedPan&#xa;status: active&#xa;source: straitsx-mcp&#xa;or local-mandate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;" vertex="1" parent="flow">
          <mxGeometry x="490" y="50" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="4. POST /checkout&#xa;{ skuId, mandate }&#xa;assertMandateAllows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="flow">
          <mxGeometry x="730" y="50" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="5. Accept → paid&#xa;burn cardOpaqueId&#xa;status: burned&#xa;HTTP 200 receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="flow">
          <mxGeometry x="970" y="50" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="6. Reject → 402&#xa;mandate rejected&#xa;(cap / merchant / TTL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;" vertex="1" parent="flow">
          <mxGeometry x="1210" y="50" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e-f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;endArrow=block;endFill=1;" edge="1" parent="1" source="f2" target="f3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D97706;endArrow=block;endFill=1;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f4a" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#16A34A;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-f4b" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;dashed=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f4" target="f6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="870" y="500" />
              <mxPoint x="1350" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Mandate shape -->
        <mxCell id="mandate" value="CardMandate shape" style="swimlane;horizontal=0;startSize=28;fillColor=#FAF5FF;strokeColor=#7C3AED;fontStyle=1;fontSize=13;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="720" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mand-fields" value="spendCap: string&#xa;merchant: string (whitelist)&#xa;expiresAt: ISO timestamp&#xa;cardOpaqueId?: string&#xa;truncatedPan?: string&#xa;status?: active | burned&#xa;source?: straitsx-mcp | local-mandate&#xa;burnedAt?: string" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;" vertex="1" parent="mandate">
