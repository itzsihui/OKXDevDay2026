<diagram id="aisle-overview" name="Aisle — High-Level Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Aisle — High-Level Overview" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="480" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Merchants publish machine-readable storefronts. Buyer agents discover, pay, and settle — no human checkout UI." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Merchants -->
        <mxCell id="merchant" value="Merchant&#xa;CSV · chat · Shopify URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Publish -->
        <mxCell id="publish" value="Publish&#xa;Merchant Agent → Store&#xa;(XSGD SKUs + wallet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="140" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Protocol -->
        <mxCell id="protocol" value="Agentic Storefront Protocol&#xa;&#xa;llms.txt · agent.json · catalog.json&#xa;POST /buy (x402) · POST /checkout (card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="120" width="320" height="120" as="geometry" />
        </mxCell>

        <!-- Buyer -->
        <mxCell id="buyer" value="Buyer Agent&#xa;intent → discover → pay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="140" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Rails -->
        <mxCell id="rail-box" value="Dual-Rail Settlement" style="swimlane;horizontal=0;startSize=28;fillColor=#F0FDF4;strokeColor=#16A34A;fontStyle=1;fontSize=13;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="200" y="340" width="1000" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rail-a" value="Rail A — Avalanche x402&#xa;&#xa;HTTP 402 → XSGD transfer on C-Chain&#xa;→ verify → HTTP 200 + Snowtrace" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="rail-box">
          <mxGeometry x="40" y="50" width="440" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rail-b" value="Rail B — StraitsX Scoped Card&#xa;&#xa;MCP mandate → spend-capped virtual card&#xa;→ checkout → burn after use" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=13;" vertex="1" parent="rail-box">
          <mxGeometry x="520" y="50" width="440" height="120" as="geometry" />
        </mxCell>

        <!-- Runtime note -->
        <mxCell id="runtime" value="Runtime: Next.js on Vercel (local protocol) · optional AWS API Gateway + Lambda + DynamoDB when PROTOCOL_BASE_URL is set · Bedrock Converse for agents (deterministic fallback)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1">
