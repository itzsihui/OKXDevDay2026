  </diagram>
<diagram id="aisle-x402" name="Rail A — Avalanche x402 Handshake">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Rail A — Avalanche x402 Handshake (in depth)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="HTTP 402 Payment Required → on-chain XSGD Transfer → verifyTransfer → HTTP 200 + order. Fail-soft: without BUYER_PRIVATE_KEY the 402 still fires." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1100" height="24" as="geometry" />
        </mxCell>

        <!-- Actors columns -->
        <mxCell id="col-buyer" value="Buyer Agent&#xa;payX402Tool / Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col-proto" value="Protocol&#xa;POST /s/:slug/buy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col-chain" value="Avalanche C-Chain&#xa;XSGD ERC-20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col-store" value="Store / Repo&#xa;memory | DynamoDB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="100" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="s1" value="1. Resolve store + SKU&#xa;slug or /registry.json product match" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. GET llms.txt + catalog.json&#xa;Confirm price &amp; payTo address" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. POST /buy { skuId, quantity, orderId }&#xa;No PAYMENT-SIGNATURE header" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="4. buildPaymentRequired()&#xa;x402Version:1 · scheme exact&#xa;maxAmountRequired · payTo · asset XSGD&#xa;extra.orderId" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. HTTP 402&#xa;PAYMENT-REQUIRED body&#xa;+ response headers" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="500" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="6. Wallet: ERC-20 transfer(payTo, amount)&#xa;viem + BUYER_PRIVATE_KEY&#xa;(Fuji 43113 or mainnet)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="720" y="500" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Retry POST /buy&#xa;Header PAYMENT-SIGNATURE = txHash&#xa;(0x… or base64 JSON {txHash})" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s8" value="8. verifyTransfer()&#xa;RPC receipt · decode Transfer event&#xa;from / to / value / asset match" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="400" y="620" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9. Persist order (paid)&#xa;txHash · explorerUrl · amountAtomic&#xa;rail: x402" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="1080" y="620" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="10. HTTP 200 + receipt&#xa;orderId · Snowtrace link&#xa;emit protocol event" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="750" width="280" height="80" as="geometry" />
        </mxCell>

        <!-- Key modules -->
        <mxCell id="mods" value="Code map" style="swimlane;horizontal=0;startSize=24;fillColor=#F8FAFC;strokeColor=#94A3B8;fontStyle=1;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="src/lib/protocol/x402.ts&#xa;buildPaymentRequired · parsePaymentSignature · verifyTransfer" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;" vertex="1" parent="mods">
          <mxGeometry x="30" y="40" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="src/lib/protocol/handlers.ts → handleBuy&#xa;402 path + paid path + idempotent paid orders" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;" vertex="1" parent="mods">
          <mxGeometry x="420" y="40" width="360" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="src/lib/agents/tools-buyer.ts → payX402Tool&#xa;full handshake orchestration" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;" vertex="1" parent="mods">
          <mxGeometry x="810" y="40" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="config: MERCHANT_ADDRESS · TOKEN_*&#xa;AVALANCHE_RPC · BUYER_PRIVATE_KEY" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;" vertex="1" parent="mods">
          <mxGeometry x="1160" y="40" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="unpaid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;fontSize=10;fontColor=#991B1B;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DC2626;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="pay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#5B21B6;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="txHash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#1E40AF;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="545" />
              <mxPoint x="700" y="580" />
              <mxPoint x="380" y="580" />
              <mxPoint x="380" y="660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D97706;endArrow=block;endFill=1;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;fontSize=10;fontColor=#166534;endArrow=block;endFill=1;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#16A34A;endArrow=block;endFill=1;" edge="1" parent="1" source="s8" target="s10"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
