        <mxCell id="e-ops-dash" value="observe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;fontSize=10;fontColor=#9A3412;endArrow=open;endFill=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ops" target="nextjs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Data flow legend: solid = primary request path · dashed = optional / observability · Green = payment · Blue = AWS/agent · Purple = chain &amp; card providers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="980" height="24" as="geometry" />
