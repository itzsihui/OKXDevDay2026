        <!-- Top arrows -->
        <mxCell id="e1" value="MCP create" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7C3AED;fontSize=10;fontColor=#5B21B6;endArrow=block;endFill=1;" edge="1" parent="1" source="card-agent" target="mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="mandate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563EB;fontSize=10;fontColor=#1E40AF;endArrow=block;endFill=1;" edge="1" parent="1" source="card-agent" target="proto"><mxGeometry relative="1" as="geometry" /></mxCell>
