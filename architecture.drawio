        <mxCell id="ssm" value="SSM Parameter Store&#xa;/aisle/{stack}/merchant-address&#xa;/aisle/{stack}/avalanche-rpc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="stack">
          <mxGeometry x="40" y="200" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="CloudWatch&#xa;Log group · metric filters&#xa;Alarm on 402→200 gap&#xa;7-day retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="stack">
          <mxGeometry x="360" y="200" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="iam" value="IAM role&#xa;least privilege:&#xa;Logs · Dynamo · SSM read" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;" vertex="1" parent="stack">
          <mxGeometry x="640" y="200" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="e-al" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="apigw" target="lambda"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ld" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563EB;endArrow=block;endFill=1;" edge="1" parent="1" source="lambda" target="ddb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="lambda" target="ssm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-lc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="lambda" target="cw"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Split brain note -->
        <mxCell id="split" value="Local vs AWS split" style="swimlane;horizontal=0;startSize=28;fillColor=#FFFBEB;strokeColor=#D97706;fontStyle=1;fontSize=13;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="1080" y="280" width="480" height="360" as="geometry" />
        </mxCell>
        <mxCell id="sp1" value="PROTOCOL_BASE_URL unset&#xa;→ Next /s/:slug handlers&#xa;→ memory or local Dynamo" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FFFFFF;strokeColor=#D97706;fontColor=#78350F;" vertex="1" parent="split">
          <mxGeometry x="30" y="50" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sp2" value="PROTOCOL_BASE_URL set&#xa;→ buyer/card agents call API GW&#xa;→ stores in AISLE_TABLE&#xa;&#xa;Onboard publishes must land&#xa;in the same table the buyer reads" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#78350F;" vertex="1" parent="split">
          <mxGeometry x="30" y="150" width="420" height="120" as="geometry" />
        </mxCell>
        <mxCell id="sp3" value="Gotcha: redeploy mints new API id.&#xa;Update both PROTOCOL_BASE_URL and&#xa;NEXT_PUBLIC_PROTOCOL_BASE_URL." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#991B1B;fontSize=11;" vertex="1" parent="split">
          <mxGeometry x="30" y="290" width="420" height="50" as="geometry" />
        </mxCell>

        <!-- Bedrock note -->
        <mxCell id="note" value="Bedrock is separate from this CFN stack — used by the Next app for agent Converse. Protocol Lambda does not invoke Bedrock." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1520" height="50" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="Params: MerchantAddress · Token* · AvalancheRpcUrl · ChainId · ExplorerBase · ArtifactBucket/Key" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#9CA3AF;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="900" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
