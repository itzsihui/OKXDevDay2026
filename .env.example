OPENAI_API_KEY=

# Firebase (buyer + merchant auth / Firestore — public web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# X Layer Testnet + USDT0 x402 (OKX Payment SDK / Onchain OS)
# Testnet: eip155:1952 · Mainnet: eip155:196
XLAYER_NETWORK=eip155:1952
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
# EVM 0x… address that receives USDT0 (merchant payTo)
MERCHANT_ADDRESS=
# Buyer private key for server-side x402 settle (never commit real keys)
BUYER_PRIVATE_KEY=
TOKEN_SYMBOL=USDT0
TOKEN_DECIMALS=6
# Testnet USDT0 (default). Mainnet: 0x779ded0c9e1022225f8e0630b35a9b54be713736
# TOKEN_ADDRESS=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
EXPLORER_BASE=https://www.okx.com/web3/explorer/xlayer-test

# OKX Facilitator (apply at OKX Developer Portal / Onchain OS)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OKX_BASE_URL=https://web3.okx.com

# Optional: DynamoDB catalog instead of Firestore (Lambda / AWS)
# AISLE_TABLE=

# Setup notes
#   1. Add X Layer Testnet to MetaMask (chainId 1952)
#   2. Claim test OKB + USDT0 from the X Layer faucet
#   3. Put buyer 0x private key in BUYER_PRIVATE_KEY and merchant 0x in MERCHANT_ADDRESS
#   4. Apply for OKX API keys at https://web3.okx.com/onchain-os/dev-portal
# Full walkthrough: scripts/setup-xlayer-usdt0.md
